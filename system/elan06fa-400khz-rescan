#!/bin/sh
# Load elan06fa_400khz and, when the kernel forced the touchpad's I2C bus to
# 100 kHz at boot, rebind the controller so the touchpad runs at 400 kHz in
# every boot. This recovers a touchpad that did not probe after a warm reboot,
# and also moves a working one (after a cold boot) to 400 kHz.
CLIENT=/sys/bus/i2c/devices/i2c-ELAN06FA:00
HID_DRIVER=/sys/bus/i2c/drivers/i2c_hid_acpi

# Bound to a driver (normally i2c_hid_acpi) means the touchpad probed fine.
detected() { [ -e "$CLIENT/driver" ]; }

# Waits up to $1 half-second steps for the touchpad to get bound.
wait_detected() {
    n=0
    while [ "$n" -lt "$1" ]; do
        detected && return 0
        sleep 0.5
        n=$((n + 1))
    done
    detected
}

# Unbinds and rebinds the controller up to 3 times, until the touchpad is back.
rebind() {
    for _ in 1 2 3; do
        echo "$ctrl" > "$driver/unbind"
        sleep 0.5
        echo "$ctrl" > "$driver/bind"
        wait_detected 6 && return 0
    done
    return 1
}

if ! modprobe elan06fa_400khz; then
    echo "Could not load elan06fa_400khz for kernel $(uname -r). With Secure Boot," \
         "check that the DKMS signing key (MOK) is enrolled."
    exit 1
fi

if [ ! -e "$CLIENT" ]; then
    echo "Touchpad I2C client not found."
    exit 1
fi
# .../<controller>/i2c-N/i2c-ELAN06FA:00 -> <controller>
ctrl_path=$(dirname "$(dirname "$(readlink -f "$CLIENT")")")
ctrl=$(basename "$ctrl_path")
driver=$(readlink -f "$ctrl_path/driver")
if [ ! -d "$driver" ]; then
    echo "Touchpad I2C controller not found."
    exit 1
fi

# dmesg is instant; the journal (slow this early in boot) is only a fallback for
# when the ring buffer has already rotated.
forced() { grep -q "$ctrl: .*forcing it to 100000"; }
if ! dmesg 2>/dev/null | forced && ! journalctl -k -b -o cat 2>/dev/null | forced; then
    echo "This kernel did not force $ctrl to 100 kHz; nothing to do."
    exit 0
fi

# i2c_hid_acpi probes asynchronously, and on systems without it in the
# initramfs udev may still be loading it: let the boot-time probe finish
# before looking at the touchpad.
if [ -d "$HID_DRIVER" ]; then
    steps=2
else
    modprobe i2c_hid_acpi 2>/dev/null
    steps=6
fi
was_working=0
wait_detected "$steps" && was_working=1

if rebind; then
    if [ "$was_working" = 1 ]; then
        echo "Touchpad moved to 400 kHz."
    else
        echo "Touchpad recovered at 400 kHz."
    fi
    exit 0
fi

if [ "$was_working" = 1 ]; then
    # It worked at 100 kHz but not at 400 kHz: go back to 100 kHz.
    modprobe -r elan06fa_400khz
    rebind
    echo "Touchpad did not come back at 400 kHz; reverted $ctrl to 100 kHz."
else
    echo "Could not recover the touchpad."
fi
exit 1
